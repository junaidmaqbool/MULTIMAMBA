    "    fig, ax = plt.subplots(figsize=(6,4))\n",
    "    ax.bar(g.index, g[\"mean\"], yerr=g[\"std\"].fillna(0),\n",
    "           color=[GROUP_COLORS[x] for x in g.index], edgecolor=\"black\", capsize=5)\n",
    "    for i,(m,c) in enumerate(zip(g[\"mean\"], g[\"count\"])):\n",
    "        ax.text(i, m, f\"{m:.3f}\\n(n={int(c)})\", ha=\"center\", va=\"bottom\", fontsize=9)\n",
    "    ax.set_ylabel(PRIMARY_LABEL); ax.set_title(f\"Family averages — {PRIMARY_LABEL} ({CV_DESC})\")\n",
    "    ax.grid(axis=\"y\", alpha=0.3)\n",
    "    plt.tight_layout(); plt.savefig(\"viz_family_averages.png\", dpi=120, bbox_inches=\"tight\"); plt.show()\n",
