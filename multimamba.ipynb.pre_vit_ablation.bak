    "df = results_df()\n",
    "if df is not None:\n",
    "    panels = [p for p in METRIC_PANELS if p[0] in df.columns]\n",
    "    fig, axes = plt.subplots(1, len(panels), figsize=(5.2*len(panels), max(3, 0.42*len(df))),\n",
    "                             sharey=True)\n",
    "    if len(panels) == 1: axes = [axes]\n",
    "    order = df.sort_values(PRIMARY, ascending=LOWER_BETTER)[\"name\"].tolist()\n",
    "    dfx = df.set_index(\"name\").reindex(order)\n",
    "    ycolors = [GROUP_COLORS[g] for g in dfx[\"group\"]]\n",
    "    for ax,(mcol,scol,mlabel,low) in zip(axes, panels):\n",
    "        ax.barh(dfx.index, dfx[mcol], xerr=dfx.get(scol), color=ycolors,\n",
    "                edgecolor=\"black\", linewidth=0.4, capsize=2)\n",
    "        ax.invert_yaxis(); ax.set_xlabel(mlabel + (\"  (lower better)\" if low else \"  (higher better)\"))\n",
    "        ax.grid(axis=\"x\", alpha=0.3)\n",
    "    fig.suptitle(f\"MULTIMAMBA — all metrics ({CV_DESC}, fusion={FUSION})\", y=1.02)\n",
    "    plt.tight_layout(); plt.savefig(\"viz_all_metrics_panel.png\", dpi=120, bbox_inches=\"tight\"); plt.show()\n",
    "    print(\"saved viz_all_metrics_panel.png\")"
   ]
