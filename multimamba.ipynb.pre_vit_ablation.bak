    "    if ABLATION_MODEL not in IMG_BUILDERS:\n",
    "        print(f\"ABLATION_MODEL '{ABLATION_MODEL}' has no builder; skipping variable ablation.\")\n",
    "    else:\n",
    "        base = IMG_BUILDERS[ABLATION_MODEL]\n",
    "        for label, feats, ses in ABLATION_STEPS:\n",
    "            try:\n",
