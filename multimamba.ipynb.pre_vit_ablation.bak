  {
   "cell_type": "markdown",
   "id": "7549c488",
   "metadata": {},
   "source": [
    "## Viz 9 — Ablation figures (fusion / per-variable / tabular-only)\n",
    "\n",
    "Requires the ablation cells above to have run. Shows the marginal value of each\n",
    "added variable and which fusion strategy works best."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3de2079a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Fusion-mode sweep ---\n",
    "if \"FUSION_ABL\" in globals() and any(r.get(\"status\")==\"PASS\" for r in FUSION_ABL):\n",
    "    fd = pd.DataFrame([r for r in FUSION_ABL if r.get(\"status\")==\"PASS\"])\n",
    "    fd[\"fusion\"] = [r[\"tag\"].split(\"=\")[-1] for r in FUSION_ABL if r.get(\"status\")==\"PASS\"]\n",
    "    fd = fd.sort_values(PRIMARY, ascending=LOWER_BETTER)\n",
    "    fig, ax = plt.subplots(figsize=(6,4))\n",
    "    ax.bar(fd[\"fusion\"], fd[PRIMARY], yerr=fd.get(PRIMARY_STD), color=\"#8e44ad\",\n",
    "           edgecolor=\"black\", capsize=5)\n",
    "    for i,v in enumerate(fd[PRIMARY]): ax.text(i,v,f\"{v:.3f}\",ha=\"center\",va=\"bottom\",fontsize=9)\n",
    "    ax.set_ylabel(PRIMARY_LABEL); ax.set_title(f\"Fusion sweep on {ABLATION_MODEL} ({CV_DESC})\")\n",
    "    ax.grid(axis=\"y\", alpha=0.3)\n",
    "    plt.tight_layout(); plt.savefig(\"viz_ablation_fusion.png\", dpi=120, bbox_inches=\"tight\"); plt.show()\n",
    "else:\n",
    "    print(\"[skip] no fusion-ablation results\")\n",
    "\n",
    "# --- Per-variable contribution ---\n",
    "if \"VARIABLE_ABL\" in globals() and any(r.get(\"status\")==\"PASS\" for r in VARIABLE_ABL):\n",
    "    vd = pd.DataFrame([r for r in VARIABLE_ABL if r.get(\"status\")==\"PASS\"])\n",
    "    vd[\"step\"] = [r[\"tag\"] for r in VARIABLE_ABL if r.get(\"status\")==\"PASS\"]\n",
    "    fig, ax = plt.subplots(figsize=(7,4))\n",
    "    ax.plot(vd[\"step\"], vd[PRIMARY], marker=\"o\", color=\"#16a085\", linewidth=2)\n",
    "    ax.errorbar(vd[\"step\"], vd[PRIMARY], yerr=vd.get(PRIMARY_STD), fmt=\"none\",\n",
    "                ecolor=\"#16a085\", capsize=4)\n",
    "    for x,v in zip(vd[\"step\"], vd[PRIMARY]): ax.text(x,v,f\" {v:.3f}\",fontsize=9)\n",
    "    ax.set_ylabel(PRIMARY_LABEL); ax.set_title(f\"Per-variable contribution on {ABLATION_MODEL}\")\n",
    "    ax.grid(alpha=0.3); plt.xticks(rotation=15)\n",
    "    plt.tight_layout(); plt.savefig(\"viz_ablation_variable.png\", dpi=120, bbox_inches=\"tight\"); plt.show()\n",
    "else:\n",
    "    print(\"[skip] no variable-ablation results\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "95883e69",
   "metadata": {},
   "source": [
    "## Viz 10 — Dataset gallery (inspect a few eye images + their labels)\n",
    "\n",
    "A grid of sample images from the merged dataset, each annotated with Hb, Height,\n",
    "Weight and SES so you can visually sanity-check the images and the tabular values\n",
    "line up. `GALLERY_N` controls how many; `GALLERY_SORT` picks the sampling."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c4623a41",
   "metadata": {},
   "outputs": [],
   "source": [
    "from PIL import Image\n",
    "\n",
    "GALLERY_N    = 12          # how many images to show\n",
    "GALLERY_COLS = 4\n",
    "GALLERY_SORT = \"spread\"    # \"spread\" = span the Hb range | \"random\" | \"anemic\" | \"normal\"\n",
    "GALLERY_DF   = FULL        # or TEST_DF to inspect the held-out set\n",
    "\n",
    "def _pick(df, n, how):\n",
    "    d = df.copy()\n",
    "    if how == \"random\":   return d.sample(min(n,len(d)), random_state=SEED)\n",
    "    if how == \"anemic\":   return d[d[HB_COL] <  HB_THRESH].head(n)\n",
    "    if how == \"normal\":   return d[d[HB_COL] >= HB_THRESH].head(n)\n",
    "    # \"spread\": evenly across the sorted Hb range\n",
    "    d = d.sort_values(HB_COL).reset_index(drop=True)\n",
    "    idx = np.linspace(0, len(d)-1, min(n,len(d))).astype(int)\n",
    "    return d.iloc[idx]\n",
    "\n",
    "sample = _pick(GALLERY_DF, GALLERY_N, GALLERY_SORT)\n",
    "rows = int(np.ceil(len(sample)/GALLERY_COLS))\n",
    "fig, axes = plt.subplots(rows, GALLERY_COLS, figsize=(3.1*GALLERY_COLS, 3.3*rows))\n",
    "axes = np.atleast_1d(axes).ravel()\n",
    "for ax in axes: ax.axis(\"off\")\n",
    "for ax, (_, r) in zip(axes, sample.iterrows()):\n",
    "    try:\n",
    "        ax.imshow(Image.open(r[\"_img_path\"]).convert(\"RGB\"))\n",
    "    except Exception as e:\n",
    "        ax.text(0.5,0.5,f\"img error\\n{e}\",ha=\"center\",va=\"center\",fontsize=7); continue\n",
    "    hb = r[HB_COL]\n",
    "    ses = str(r.get(SES_COL,\"?\")).strip()\n",
    "    ht  = r.get(HEIGHT_COL,\"?\"); wt = r.get(WEIGHT_COL,\"?\")\n",
    "    tag = \"ANEMIC\" if hb < HB_THRESH else \"normal\"\n",
    "    ax.set_title(f\"Hb={hb:.1f} ({tag})\\nH={ht}  W={wt}  SES={ses}\", fontsize=8,\n",
    "                 color=(\"#c0392b\" if hb<HB_THRESH else \"#2c3e50\"))\n",
    "    ax.axis(\"off\")\n",
    "fig.suptitle(f\"Dataset gallery — {GALLERY_SORT} sample of {len(sample)} images\", y=1.01)\n",
    "plt.tight_layout(); plt.savefig(\"viz_dataset_gallery.png\", dpi=120, bbox_inches=\"tight\"); plt.show()\n",
    "print(\"saved viz_dataset_gallery.png\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5466df8d",
   "metadata": {},
   "source": [
    "## Viz 11 — Tabular variable distributions & Hb relationships"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3ceb79bb",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = FULL.copy()\n",
    "df[\"_hb\"] = pd.to_numeric(df[HB_COL], errors=\"coerce\")\n",
    "df[\"_ht\"] = pd.to_numeric(df.get(HEIGHT_COL), errors=\"coerce\")\n",
    "df[\"_wt\"] = pd.to_numeric(df.get(WEIGHT_COL), errors=\"coerce\")\n",
    "df[\"_ses\"] = df.get(SES_COL, pd.Series([\"?\"]*len(df))).astype(str).str.strip()\n",
    "\n",
    "fig, ax = plt.subplots(2, 3, figsize=(15, 8))\n",
    "\n",
    "ax[0,0].hist(df[\"_hb\"].dropna(), bins=25, color=\"#e74c3c\", edgecolor=\"black\")\n",
    "ax[0,0].axvline(HB_THRESH, color=\"black\", ls=\"--\", label=f\"anaemia thr={HB_THRESH}\")\n",
    "ax[0,0].set_title(\"Haemoglobin (g/dL)\"); ax[0,0].legend(fontsize=8)\n",
    "\n",
    "ax[0,1].hist(df[\"_ht\"].dropna(), bins=25, color=\"#3498db\", edgecolor=\"black\")\n",
    "ax[0,1].set_title(f\"{HEIGHT_COL}\")\n",
    "ax[0,2].hist(df[\"_wt\"].dropna(), bins=25, color=\"#2ecc71\", edgecolor=\"black\")\n",
    "ax[0,2].set_title(f\"{WEIGHT_COL}\")\n",
    "\n",
    "# SES counts\n",
    "vc = df[\"_ses\"].value_counts()\n",
    "ax[1,0].bar(vc.index, vc.values, color=\"#9b59b6\", edgecolor=\"black\")\n",
    "ax[1,0].set_title(f\"{SES_COL} counts\")\n",
    "for i,v in enumerate(vc.values): ax[1,0].text(i,v,str(v),ha=\"center\",va=\"bottom\")\n",
    "\n",
    "# Hb vs Weight coloured by SES\n",
    "for s,c in [(\"APL\",\"#e67e22\"),(\"BPL\",\"#1abc9c\")]:\n",
    "    sub = df[df[\"_ses\"]==s]\n",
    "    ax[1,1].scatter(sub[\"_wt\"], sub[\"_hb\"], s=14, alpha=0.6, label=s, color=c)\n",
    "ax[1,1].set_xlabel(WEIGHT_COL); ax[1,1].set_ylabel(HB_COL)\n",
    "ax[1,1].set_title(\"Hb vs Weight by SES\"); ax[1,1].legend(fontsize=8)\n",
    "\n",
    "# Hb by SES boxplot\n",
    "groups = [df[df[\"_ses\"]==s][\"_hb\"].dropna() for s in vc.index]\n",
    "ax[1,2].boxplot(groups, labels=list(vc.index))\n",
    "ax[1,2].axhline(HB_THRESH, color=\"red\", ls=\"--\")\n",
    "ax[1,2].set_title(\"Hb distribution by SES\")\n",
    "\n",
    "for a in ax.ravel(): a.grid(alpha=0.25)\n",
    "plt.tight_layout(); plt.savefig(\"viz_tabular_distributions.png\", dpi=120, bbox_inches=\"tight\"); plt.show()\n",
    "\n",
    "# quick numeric summary + correlations with Hb\n",
    "print(df[[\"_hb\",\"_ht\",\"_wt\"]].describe().round(2).to_string())\n",
    "print(\"\\nSES value counts:\", vc.to_dict())\n",
    "corr = df[[\"_hb\",\"_ht\",\"_wt\"]].corr()[\"_hb\"].round(3)\n",
    "print(\"\\nCorrelation with Hb:  Height=%s  Weight=%s\" % (corr[\"_ht\"], corr[\"_wt\"]))\n",
    "print(\"saved viz_tabular_distributions.png\")"
   ]
  }
