   "source": [
    "# ─────────────────────────  VISUALISATIONS  ─────────────────────────\n",
    "\n",
    "All comparison figures for the paper. Cells below plot the main-pass `RESULTS`\n",
    "broken down by architecture family — **Mamba**, **CNN**, **ViT** — separately and\n",
    "together, plus a dataset gallery so you can eyeball a few samples and the tabular\n",
    "variable distributions. Every figure is also saved as a PNG next to the notebook.\n",
    "Run the MAIN PASS (Section 11-12) before running these."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "91dea6ce",
   "metadata": {},
   "source": [
    "## Viz 0 — Model-family groups & plotting helpers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "25aa0ff7",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np, pandas as pd, os\n",
    "\n",
    "# --- architecture families -------------------------------------------------\n",
    "MODEL_GROUPS = {\n",
    "    \"Mamba\": [\"Mamba1\",\"Mamba2\",\"Mamba3\",\"VMamba\",\"MambaVision\",\"MedMamba\",\"VSSD\",\n",
    "              \"DSA_Mamba\",\"EfficientMamba\",\"AdaptiveScan\",\"MoEMamba\",\"CrossFusion\"],\n",
    "    \"CNN\":   [\"ResNet50\",\"EfficientNetB3\",\"DenseNet121\",\"MobileNetV3\"],\n",
    "    \"ViT\":   [\"ViT_B16\"],\n",
    "}\n",
    "GROUP_COLORS = {\"Mamba\":\"#c0392b\", \"CNN\":\"#2980b9\", \"ViT\":\"#27ae60\", \"Other\":\"#7f8c8d\"}\n",
    "\n",
    "def group_of(name):\n",
    "    for g, names in MODEL_GROUPS.items():\n",
    "        if name in names: return g\n",
    "    return \"Other\"\n",
    "\n",
    "# primary metric depends on the task (set in the variables block)\n",
    "if TASK == \"classification\":\n",
    "    PRIMARY, PRIMARY_STD, PRIMARY_LABEL, LOWER_BETTER = \"auc_mean\",\"auc_std\",\"Test AUC\", False\n",
    "    METRIC_PANELS = [(\"acc_mean\",\"acc_std\",\"Accuracy\",False),\n",
    "                     (\"auc_mean\",\"auc_std\",\"AUC\",False),\n",
    "                     (\"f1_mean\",\"f1_std\",\"F1\",False)]\n",
    "else:\n",
    "    PRIMARY, PRIMARY_STD, PRIMARY_LABEL, LOWER_BETTER = \"mae_mean\",\"mae_std\",\"Test MAE (g/dL)\", True\n",
    "    METRIC_PANELS = [(\"mae_mean\",\"mae_std\",\"MAE (g/dL)\",True),\n",
    "                     (\"rmse_mean\",\"rmse_std\",\"RMSE (g/dL)\",True),\n",
    "                     (\"r2_mean\",\"r2_std\",\"R2\",False)]\n",
    "\n",
    "def results_df(rows=None):\n",
    "    \"\"\"Tidy DataFrame of PASS rows with a 'group' column, sorted best-first.\"\"\"\n",
    "    rows = RESULTS if rows is None else rows\n",
    "    ok = [r for r in rows if r.get(\"status\") == \"PASS\"]\n",
    "    if not ok:\n",
    "        return None\n",
    "    df = pd.DataFrame(ok).copy()\n",
    "    df[\"group\"] = df[\"name\"].map(group_of)\n",
    "    df = df.sort_values(PRIMARY, ascending=LOWER_BETTER).reset_index(drop=True)\n",
    "    return df\n",
    "\n",
    "def plot_bar(df, title, fname, color_by_group=True):\n",
    "    \"\"\"Horizontal bar of the primary metric with std error bars.\"\"\"\n",
    "    if df is None or len(df) == 0:\n",
    "        print(f\"[skip] {title}: no data\"); return\n",
    "    fig, ax = plt.subplots(figsize=(11, max(2.5, 0.5*len(df))))\n",
    "    colors = [GROUP_COLORS[g] for g in df[\"group\"]] if color_by_group else \"#34495e\"\n",
    "    ax.barh(df[\"name\"], df[PRIMARY], xerr=df.get(PRIMARY_STD),\n",
    "            color=colors, edgecolor=\"black\", linewidth=0.4, capsize=3)\n",
    "    for y,(v,) in enumerate(zip(df[PRIMARY])):\n",
    "        ax.text(v, y, f\" {v:.3f}\", va=\"center\", fontsize=8)\n",
    "    ax.invert_yaxis()\n",
    "    ax.set_xlabel(PRIMARY_LABEL + (\"  (lower is better)\" if LOWER_BETTER else \"  (higher is better)\"))\n",
    "    ax.set_title(title)\n",
    "    if color_by_group:\n",
    "        from matplotlib.patches import Patch\n",
    "        present = [g for g in GROUP_COLORS if g in set(df[\"group\"])]\n",
    "        ax.legend(handles=[Patch(color=GROUP_COLORS[g], label=g) for g in present],\n",
    "                  loc=\"lower right\", fontsize=8)\n",
    "    ax.grid(axis=\"x\", alpha=0.3)\n",
    "    plt.tight_layout(); plt.savefig(fname, dpi=120, bbox_inches=\"tight\"); plt.show()\n",
    "    print(\"saved\", fname)\n",
    "\n",
    "_ALL = results_df()\n",
    "if _ALL is not None:\n",
    "    print(\"Models available for plotting:\", list(_ALL[\"name\"]))\n",
    "    print(\"Groups present:\", sorted(set(_ALL[\"group\"])))\n",
    "else:\n",
    "    print(\"No PASS results yet — run the MAIN PASS (Section 11) first.\")"
   ]
  },
