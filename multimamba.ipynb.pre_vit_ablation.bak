   "source": [
    "import os, sys, math, time, warnings, traceback, importlib.util, gc\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import transforms\n",
    "from PIL import Image, ImageFile\n",
    "ImageFile.LOAD_TRUNCATED_IMAGES = True\n",
    "from sklearn.model_selection import train_test_split, StratifiedKFold\n",
    "from sklearn.metrics import (accuracy_score, classification_report, roc_auc_score,\n",
    "                             mean_absolute_error, f1_score, confusion_matrix, r2_score)\n",
    "from sklearn.utils.class_weight import compute_class_weight\n",
    "from tqdm import tqdm\n",
    "import matplotlib.pyplot as plt\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "torch.manual_seed(SEED); np.random.seed(SEED)\n",
    "DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"Device: {DEVICE}   PyTorch: {torch.__version__}\")\n",
    "if MODELS_DIR not in sys.path: sys.path.insert(0, MODELS_DIR)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c6dcf3a9",
   "metadata": {},
   "source": [
    "## Section 4 — Data: merge, filter, and lock the fixed test set\n",
    "\n",
    "Reuses the exact `merge_and_filter_datasets` loader from `common/augment.py` (it\n",
    "preserves every Excel column, so Height/Weight/SES flow through untouched). We build\n",
    "the fixed 10% held-out **test set** and the **train+val pool**; folds are drawn from\n",
    "the pool only. Tabular columns are validated and their coverage reported."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bfe22ffc",
   "metadata": {},
   "outputs": [],
   "source": [
    "from common.augment import merge_and_filter_datasets, make_balanced_loader\n",
    "\n",
    "# ---------- image preprocessing (same as run_ensemble) ----------\n",
    "class CLAHETransform:\n",
    "    def __call__(self, img):\n",
    "        import cv2\n",
    "        lab = cv2.cvtColor(np.array(img), cv2.COLOR_RGB2LAB)\n",
    "        clahe = cv2.createCLAHE(clipLimit=PREPROCESS[\"clahe_clip\"],\n",
    "                                tileGridSize=PREPROCESS[\"clahe_grid\"])\n",
    "        lab[:, :, 0] = clahe.apply(lab[:, :, 0])\n",
    "        return Image.fromarray(cv2.cvtColor(lab, cv2.COLOR_LAB2RGB))\n",
    "\n",
    "class ToLABTensor:\n",
    "    def __call__(self, img):\n",
    "        import cv2\n",
    "        lab = cv2.cvtColor(np.array(img).astype(np.uint8), cv2.COLOR_RGB2LAB).astype(np.float32)\n",
    "        lab[:, :, 0] /= 255.0\n",
    "        lab[:, :, 1] = (lab[:, :, 1] - 128.0) / 127.0\n",
    "        lab[:, :, 2] = (lab[:, :, 2] - 128.0) / 127.0\n",
    "        return torch.from_numpy(lab.transpose(2, 0, 1))\n",
    "\n",
    "class ToHSVTensor:\n",
    "    def __call__(self, img):\n",
    "        import cv2\n",
    "        hsv = cv2.cvtColor(np.array(img).astype(np.uint8), cv2.COLOR_RGB2HSV).astype(np.float32)\n",
    "        hsv[:, :, 0] /= 179.0; hsv[:, :, 1] /= 255.0; hsv[:, :, 2] /= 255.0\n",
    "        return torch.from_numpy(hsv.transpose(2, 0, 1))\n",
    "\n",
    "def build_transforms(augment):\n",
    "    steps = []\n",
    "    if augment:\n",
    "        steps += [transforms.Resize((IMG_SIZE + 32, IMG_SIZE + 32)),\n",
    "                  transforms.RandomCrop(IMG_SIZE),\n",
    "                  transforms.RandomHorizontalFlip(),\n",
    "                  transforms.RandomRotation(15),\n",
    "                  transforms.ColorJitter(0.25, 0.25, 0.15)]\n",
    "    else:\n",
    "        steps.append(transforms.Resize((IMG_SIZE, IMG_SIZE)))\n",
    "    if PREPROCESS[\"use_clahe\"]:\n",
    "        steps.append(CLAHETransform())\n",
    "    cs = PREPROCESS[\"colorspace\"].upper()\n",
    "    if cs == \"RGB\":\n",
    "        steps += [transforms.ToTensor(), transforms.Normalize((0.5,)*3, (0.5,)*3)]\n",
    "    elif cs == \"CIELAB\": steps.append(ToLABTensor())\n",
    "    elif cs == \"HSV\":    steps.append(ToHSVTensor())\n",
    "    elif cs in (\"GRAY\", \"GRAYSCALE\"):\n",
    "        steps += [transforms.Grayscale(3), transforms.ToTensor(),\n",
    "                  transforms.Normalize((0.5,)*3, (0.5,)*3)]\n",
    "    else: raise ValueError(f\"Unknown colorspace {PREPROCESS['colorspace']}\")\n",
    "    return transforms.Compose(steps)\n",
    "\n",
    "_IMG_EXTS = [\".jpg\", \".jpeg\", \".png\", \".bmp\", \"\"]\n",
    "def find_image_path(pid, img_dir):\n",
    "    for ext in _IMG_EXTS:\n",
    "        p = os.path.join(img_dir, str(pid) + ext)\n",
    "        if os.path.exists(p): return p\n",
    "    return None\n",
    "\n",
    "# ---------- load + merge ----------\n",
    "def _load_full_df():\n",
    "    slot_dfs, slot_dirs = [], []\n",
    "    for csv_p, img_d in [(CSV_PATH, IMAGE_DIR), (CSV_PATH_2, IMAGE_DIR_2)]:\n",
    "        if csv_p and img_d:\n",
    "            _df = (pd.read_excel(csv_p) if csv_p.endswith((\".xlsx\", \".xls\"))\n",
    "                   else pd.read_csv(csv_p))\n",
    "            slot_dfs.append(_df); slot_dirs.append(img_d)\n",
    "    if not slot_dfs:\n",
    "        raise RuntimeError(\"No dataset slots active. Set CSV_PATH and IMAGE_DIR.\")\n",
    "    df = merge_and_filter_datasets(\n",
    "        dataframes=slot_dfs, image_dirs=slot_dirs, hb_col=HB_COL, image_col=IMAGE_COL,\n",
    "        hb_filter_min=HB_FILTER_MIN, hb_filter_max=HB_FILTER_MAX,\n",
    "        find_image_path_fn=find_image_path, verbose=True)\n",
    "    if len(df) == 0:\n",
    "        raise RuntimeError(\"Zero valid samples after filtering.\")\n",
    "    return df.reset_index(drop=True)\n",
    "\n",
    "FULL = _load_full_df()\n",
    "\n",
    "# ---------- validate tabular columns ----------\n",
    "def _report_col(col):\n",
    "    if col not in FULL.columns:\n",
    "        print(f\"  [WARN] tabular column '{col}' NOT found in the sheet -> \"\n",
    "              f\"it will be imputed as 0. Available: {list(FULL.columns)}\")\n",
    "        return False\n",
    "    if col == SES_COL:\n",
    "        n_ok = FULL[col].astype(str).str.strip().isin(list(SES_MAP)).sum()\n",
    "    else:\n",
    "        n_ok = pd.to_numeric(FULL[col], errors='coerce').notna().sum()\n",
    "    print(f\"  [OK]  '{col}': {n_ok}/{len(FULL)} usable values\")\n",
    "    return True\n",
    "\n",
    "print(\"Tabular column check:\")\n",
    "for c in NUMERIC_FEATURES: _report_col(c)\n",
    "_report_col(SES_COL)\n",
    "if SES_COL in FULL.columns:\n",
    "    print(\"  SES value counts:\", FULL[SES_COL].astype(str).str.strip().value_counts().to_dict())\n",
    "\n",
    "# ---------- fixed test split + train/val pool ----------\n",
    "_binary = (FULL[HB_COL] < HB_THRESH).astype(int)\n",
    "POOL_DF, TEST_DF = train_test_split(\n",
    "    FULL, test_size=TEST_SPLIT, random_state=SEED, stratify=_binary)\n",
    "POOL_DF  = POOL_DF.reset_index(drop=True)\n",
    "TEST_DF  = TEST_DF.reset_index(drop=True)\n",
    "POOL_LBL = (POOL_DF[HB_COL] < HB_THRESH).astype(int).values\n",
    "\n",
    "n_anem = int(_binary.sum())\n",
    "print(f\"\\n  Samples: {len(FULL)}  | Anemic(<{HB_THRESH}): {n_anem} \"\n",
    "      f\"({n_anem/len(FULL)*100:.1f}%)  Normal: {len(FULL)-n_anem}\")\n",
    "print(f\"  Train+Val pool: {len(POOL_DF)}   Fixed Test: {len(TEST_DF)}\")\n",
    "print(f\"  Hb -> mean={FULL[HB_COL].mean():.2f}  std={FULL[HB_COL].std():.2f}  \"\n",
    "      f\"min={FULL[HB_COL].min():.2f}  max={FULL[HB_COL].max():.2f}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1ba9ee21",
   "metadata": {},
   "source": [
    "## Section 5 — Tabular preprocessing & multimodal dataset\n",
    "\n",
    "`fit_tab_stats` computes mean/std of the numeric variables **on training rows only**\n",
    "(per fold) so the test/val standardisation never leaks. `MMDataset` returns\n",
    "`(image, tabular_vector, class_label, hb_value)`; the tabular vector length adapts to\n",
    "the active feature set (`numeric_feats` + optional SES)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "68456269",
   "metadata": {},
   "outputs": [],
   "source": [
    "def fit_tab_stats(df, numeric_feats):\n",
    "    \"\"\"Per-fold standardisation stats from TRAIN rows only. Returns {col:(mean,std)}.\"\"\"\n",
    "    stats = {}\n",
    "    for c in numeric_feats:\n",
    "        if c in df.columns:\n",
    "            v = pd.to_numeric(df[c], errors=\"coerce\")\n",
    "            m = float(v.mean()) if v.notna().any() else 0.0\n",
    "            s = float(v.std())  if v.notna().any() else 1.0\n",
    "        else:\n",
    "            m, s = 0.0, 1.0\n",
    "        stats[c] = (m, max(s, 1e-6))\n",
    "    return stats\n",
    "\n",
    "def _row_tab_vector(row, numeric_feats, use_ses, stats):\n",
    "    vec = []\n",
    "    for c in numeric_feats:\n",
    "        m, s = stats[c]\n",
    "        x = pd.to_numeric(pd.Series([row.get(c, np.nan)]), errors=\"coerce\").iloc[0]\n",
    "        vec.append(0.0 if pd.isna(x) else (float(x) - m) / s)   # nan -> mean(=0)\n",
    "    if use_ses:\n",
    "        raw = str(row.get(SES_COL, \"\")).strip()\n",
    "        vec.append(float(SES_MAP.get(raw, 0.0)))\n",
    "    return np.asarray(vec, dtype=np.float32)\n",
    "\n",
    "class MMDataset(Dataset):\n",
    "    def __init__(self, df, transform, numeric_feats, use_ses, stats):\n",
    "        self.df = df.reset_index(drop=True)\n",
    "        self.transform = transform\n",
    "        self.numeric_feats = numeric_feats\n",
    "        self.use_ses = use_ses\n",
    "        self.stats = stats\n",
    "        self.tab_dim = len(numeric_feats) + (1 if use_ses else 0)\n",
    "\n",
    "    def __len__(self): return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        hb  = float(row[HB_COL])\n",
    "        lbl = 0 if hb < HB_THRESH else 1\n",
    "        img = Image.open(row[\"_img_path\"]).convert(\"RGB\")\n",
    "        if self.transform: img = self.transform(img)\n",
    "        tab = torch.from_numpy(_row_tab_vector(row, self.numeric_feats, self.use_ses, self.stats))\n",
    "        if self.tab_dim == 0:                      # image-only ablation\n",
    "            tab = torch.zeros(0, dtype=torch.float32)\n",
    "        return img, tab, torch.tensor(lbl, dtype=torch.long), torch.tensor(hb, dtype=torch.float32)\n",
    "\n",
    "print(\"Tabular + MMDataset ready.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9cade29b",
   "metadata": {},
   "source": [
    "## Section 6 — Multimodal fusion wrapper (works on ANY model)\n",
    "\n",
    "`MultiModalWrapper` wraps any `(logits, hb)` image model. A forward-pre-hook captures\n",
    "the pooled feature entering `cls_head` (`feat_dim` is read straight off that head).\n",
    "Four fusion modes:\n",
    "\n",
    "- **concat** — glue `[image_feat ; tab_feat]`, then heads (simple baseline).\n",
    "- **film**  — tabular data predicts per-channel `(gamma, beta)`; `feat*(1+gamma)+beta` (feature-wise modulation).\n",
    "- **gate**  — tabular data predicts a sigmoid gate over image channels.\n",
    "- **attn**  — image feature + each tabular scalar become tokens; a Transformer\n",
    "  encoder layer lets them cross-attend; the image token output is used.\n",
    "\n",
    "`ImageOnlyWrapper` (ignores tab) and `TabularOnlyModel` (ignores image) share the same\n",
    "`forward(img, tab)` signature so the training loop is identical everywhere."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "744bdc20",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _infer_feat_dim(cls_head):\n",
    "    if isinstance(cls_head, nn.Linear):\n",
    "        return cls_head.in_features\n",
    "    for m in cls_head.modules():\n",
    "        if isinstance(m, nn.Linear):   return m.in_features\n",
    "        if isinstance(m, nn.LayerNorm):\n",
    "            ns = m.normalized_shape\n",
    "            return ns[0] if isinstance(ns, (tuple, list)) else int(ns)\n",
    "    raise ValueError(\"Could not infer feat_dim from cls_head\")\n",
    "\n",
    "def _mlp(inp, hid):\n",
    "    return nn.Sequential(nn.Linear(inp, hid), nn.GELU(),\n",
    "                         nn.LayerNorm(hid), nn.Linear(hid, hid), nn.GELU())\n",
    "\n",
    "def _make_heads(dim, dropout):\n",
    "    cls = nn.Sequential(nn.LayerNorm(dim), nn.Dropout(dropout), nn.Linear(dim, 2))\n",
    "    reg = nn.Sequential(nn.LayerNorm(dim), nn.Linear(dim, max(dim // 2, 8)),\n",
    "                        nn.GELU(), nn.Linear(max(dim // 2, 8), 1))\n",
    "    return cls, reg\n",
    "\n",
    "class MultiModalWrapper(nn.Module):\n",
    "    def __init__(self, image_model, tab_dim, fusion=\"film\",\n",
    "                 tab_hidden=TAB_HIDDEN, fuse_dim=FUSE_DIM, dropout=TAB_DROPOUT):\n",
    "        super().__init__()\n",
    "        assert tab_dim > 0, \"MultiModalWrapper needs tab_dim>0 (use ImageOnlyWrapper otherwise)\"\n",
    "        self.image_model = image_model\n",
    "        self.fusion = fusion\n",
    "        self.tab_dim = tab_dim\n",
    "        feat_dim = _infer_feat_dim(image_model.cls_head)\n",
    "        self.feat_dim = feat_dim\n",
    "        self._feat = None\n",
    "        image_model.cls_head.register_forward_pre_hook(self._hook)\n",
    "\n",
    "        if fusion == \"concat\":\n",
    "            self.tab_enc = _mlp(tab_dim, tab_hidden); fused = feat_dim + tab_hidden\n",
    "        elif fusion == \"film\":\n",
    "            self.tab_enc = _mlp(tab_dim, tab_hidden)\n",
    "            self.film = nn.Linear(tab_hidden, feat_dim * 2); fused = feat_dim\n",
    "        elif fusion == \"gate\":\n",
    "            self.tab_enc = _mlp(tab_dim, tab_hidden)\n",
    "            self.gate = nn.Linear(tab_hidden, feat_dim); fused = feat_dim\n",
    "        elif fusion == \"attn\":\n",
    "            self.img_proj = nn.Linear(feat_dim, fuse_dim)\n",
    "            self.tok_proj = nn.ModuleList([nn.Linear(1, fuse_dim) for _ in range(tab_dim)])\n",
    "            self.attn = nn.TransformerEncoderLayer(\n",
    "                d_model=fuse_dim, nhead=4, dim_feedforward=fuse_dim * 2,\n",
    "                dropout=dropout, batch_first=True, activation=\"gelu\")\n",
    "            fused = fuse_dim\n",
    "        else:\n",
    "            raise ValueError(f\"Unknown fusion '{fusion}'\")\n",
    "        self.fused_dim = fused\n",
    "        self.cls_head, self.reg_head = _make_heads(fused, dropout)\n",
    "\n",
    "    def _hook(self, module, inp): self._feat = inp[0]\n",
    "\n",
    "    def forward(self, img, tab):\n",
    "        _ = self.image_model(img)               # runs backbone; hook captures pooled feat\n",
    "        f = self._feat                           # (B, feat_dim)\n",
    "        tab = tab.to(f.dtype)\n",
    "        if self.fusion == \"concat\":\n",
    "            fused = torch.cat([f, self.tab_enc(tab)], dim=-1)\n",
    "        elif self.fusion == \"film\":\n",
    "            g, b = self.film(self.tab_enc(tab)).chunk(2, dim=-1)\n",
    "            fused = f * (1.0 + g) + b\n",
    "        elif self.fusion == \"gate\":\n",
    "            fused = f * torch.sigmoid(self.gate(self.tab_enc(tab)))\n",
    "        elif self.fusion == \"attn\":\n",
    "            toks = [self.img_proj(f).unsqueeze(1)]\n",
    "            for i, proj in enumerate(self.tok_proj):\n",
    "                toks.append(proj(tab[:, i:i+1]).unsqueeze(1))\n",
    "            seq = torch.cat(toks, dim=1)         # (B, 1+tab_dim, fuse_dim)\n",
    "            fused = self.attn(seq)[:, 0]         # image-token output\n",
    "        return self.cls_head(fused), self.reg_head(fused).squeeze(-1)\n",
    "\n",
    "class ImageOnlyWrapper(nn.Module):\n",
    "    \"\"\"Baseline: ignores tabular input, keeps the model's own heads. Unified signature.\"\"\"\n",
    "    def __init__(self, image_model):\n",
    "        super().__init__(); self.image_model = image_model\n",
    "    def forward(self, img, tab):\n",
    "        return self.image_model(img)\n",
    "\n",
    "class TabularOnlyModel(nn.Module):\n",
    "    \"\"\"Reference: predicts from tabular variables alone (no image).\"\"\"\n",
    "    def __init__(self, tab_dim, hidden=64, dropout=TAB_DROPOUT):\n",
    "        super().__init__()\n",
    "        self.net = _mlp(max(tab_dim, 1), hidden)\n",
    "        self.tab_dim = tab_dim\n",
    "        self.cls_head, self.reg_head = _make_heads(hidden, dropout)\n",
    "    def forward(self, img, tab):\n",
    "        if self.tab_dim == 0:\n",
    "            tab = torch.zeros(img.size(0), 1, device=img.device)\n",
    "        h = self.net(tab)\n",
    "        return self.cls_head(h), self.reg_head(h).squeeze(-1)\n",
    "\n",
    "print(\"Fusion wrappers ready:  MultiModalWrapper / ImageOnlyWrapper / TabularOnlyModel\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2cce16fa",
   "metadata": {},
   "source": [
    "## Section 7 — Task-specific losses & metrics\n",
    "\n",
    "Classification and regression use **separate** functions — nothing shared beyond the\n",
    "training skeleton. Classification: Focal/CE with balanced class weights, evaluated by\n",
    "Accuracy / AUC / macro-F1 with threshold tuning. Regression: Huber/MAE/MSE on\n",
    "normalised Hb, evaluated by MAE / RMSE / R2."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0968a56d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ---------------- CLASSIFICATION ----------------\n",
    "class FocalLoss(nn.Module):\n",
    "    def __init__(self, gamma=2.0, weight=None):\n",
    "        super().__init__(); self.gamma = gamma; self.weight = weight\n",
    "    def forward(self, logits, targets):\n",
    "        ce = F.cross_entropy(logits, targets, weight=self.weight, reduction=\"none\")\n",
    "        pt = torch.exp(-ce)\n",
    "        return (((1 - pt) ** self.gamma) * ce).mean()\n",
    "\n",
    "def build_cls_loss(train_labels):\n",
    "    wt = None\n",
    "    if CLS_CONFIG[\"use_class_weights\"] and len(train_labels) > 0:\n",
    "        w = compute_class_weight(\"balanced\", classes=np.array([0, 1]),\n",
    "                                 y=np.array(train_labels))\n",
    "        wt = torch.tensor(w, dtype=torch.float32).to(DEVICE)\n",
    "    if CLS_CONFIG[\"use_focal_loss\"]:\n",
    "        return FocalLoss(gamma=CLS_CONFIG[\"focal_gamma\"], weight=wt)\n",
    "    return nn.CrossEntropyLoss(weight=wt)\n",
    "\n",
    "def cls_metrics(labels, preds, scores):\n",
    "    m = {\"acc\": accuracy_score(labels, preds),\n",
    "         \"f1\":  f1_score(labels, preds, average=\"macro\", zero_division=0)}\n",
    "    try:    m[\"auc\"] = roc_auc_score(labels, scores)\n",
    "    except Exception: m[\"auc\"] = float(\"nan\")\n",
    "    return m\n",
    "\n",
    "def find_best_threshold(labels, scores):\n",
    "    best_t, best_f = 0.5, 0.0\n",
    "    for t in np.arange(0.10, 0.91, 0.01):\n",
    "        f = f1_score(labels, [1 if s >= t else 0 for s in scores],\n",
    "                     average=\"macro\", zero_division=0)\n",
    "        if f > best_f: best_f, best_t = f, round(float(t), 2)\n",
    "    return best_t, best_f\n",
    "\n",
    "# ---------------- REGRESSION ----------------\n",
    "def _norm_hb(hb):   return (hb - REG_CONFIG[\"hb_min\"]) / (REG_CONFIG[\"hb_max\"] - REG_CONFIG[\"hb_min\"])\n",
    "def _denorm_hb(x):  return x * (REG_CONFIG[\"hb_max\"] - REG_CONFIG[\"hb_min\"]) + REG_CONFIG[\"hb_min\"]\n",
    "\n",
    "def build_reg_loss():\n",
    "    fn = REG_CONFIG[\"loss_fn\"].lower()\n",
    "    if fn == \"huber\": return nn.HuberLoss(delta=REG_CONFIG[\"huber_delta\"])\n",
    "    if fn == \"mae\":   return nn.L1Loss()\n",
    "    return nn.MSELoss()\n",
    "\n",
    "def reg_metrics(hb_true, hb_pred):\n",
    "    at, ap = np.asarray(hb_true), np.asarray(hb_pred)\n",
    "    return {\"mae\":  float(np.mean(np.abs(at - ap))),\n",
    "            \"rmse\": float(np.sqrt(np.mean((at - ap) ** 2))),\n",
    "            \"r2\":   float(r2_score(at, ap)) if len(at) > 1 else float(\"nan\")}\n",
    "\n",
    "class EarlyStopper:\n",
    "    def __init__(self, patience): self.p = patience; self.n = 0; self.best = float(\"inf\")\n",
    "    def step(self, s):\n",
    "        if s < self.best - 1e-6: self.best = s; self.n = 0; return False\n",
    "        self.n += 1; return self.p > 0 and self.n >= self.p\n",
    "\n",
    "print(\"Losses & metrics ready (classification and regression kept separate).\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fab24abd",
   "metadata": {},
   "source": [
    "## Section 8 — Multimodal epoch loop\n",
    "\n",
    "Unpacks `(img, tab, label, hb)` and calls `model(img, tab)`. Loss dispatch is\n",
    "task-specific; AMP, gradient accumulation, and clipping match the original pipeline."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "69daae51",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_epoch_mm(model, loader, cls_loss=None, reg_loss=None,\n",
    "                 optimizer=None, grad_accum=1, scaler=None):\n",
    "    import contextlib\n",
    "    training = optimizer is not None\n",
    "    model.train() if training else model.eval()\n",
    "    total = 0.0\n",
    "    P, Y, S, HBP, HBT = [], [], [], [], []\n",
    "    if training: optimizer.zero_grad()\n",
    "    ctx = torch.enable_grad() if training else torch.no_grad()\n",
    "    with ctx:\n",
    "        for bi, (imgs, tab, labels, hb) in enumerate(\n",
    "                tqdm(loader, leave=False, desc=\"train\" if training else \"eval \")):\n",
    "            imgs, tab = imgs.to(DEVICE), tab.to(DEVICE)\n",
    "            labels, hb = labels.to(DEVICE), hb.to(DEVICE)\n",
    "            amp = torch.cuda.amp.autocast() if scaler is not None else contextlib.nullcontext()\n",
    "            with amp:\n",
    "                logits, hb_pred = model(imgs, tab)\n",
    "                if TASK == \"classification\":\n",
    "                    loss = cls_loss(logits, labels)\n",
    "                else:\n",
    "                    ht = _norm_hb(hb) if REG_CONFIG[\"normalize_hb\"] else hb\n",
    "                    loss = reg_loss(hb_pred.view(-1), ht.view(-1))\n",
    "            if training:\n",
    "                (scaler.scale(loss / grad_accum) if scaler else (loss / grad_accum)).backward()\n",
    "                last = (bi + 1 == len(loader))\n",
    "                if (bi + 1) % grad_accum == 0 or last:\n",
    "                    if scaler:\n",
    "                        scaler.unscale_(optimizer)\n",
    "                        nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "                        scaler.step(optimizer); scaler.update()\n",
    "                    else:\n",
    "                        nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "                        optimizer.step()\n",
    "                    optimizer.zero_grad()\n",
    "            total += loss.item()\n",
    "            if TASK == \"classification\":\n",
    "                probs = torch.softmax(logits, dim=1)\n",
    "                P.extend(logits.argmax(1).cpu().tolist())\n",
    "                Y.extend(labels.cpu().tolist())\n",
    "                S.extend(probs[:, 1].cpu().tolist())\n",
    "            else:\n",
    "                hp = hb_pred.detach().view(-1)\n",
    "                if REG_CONFIG[\"normalize_hb\"]: hp = _denorm_hb(hp)\n",
    "                HBP.extend(hp.cpu().tolist()); HBT.extend(hb.cpu().view(-1).tolist())\n",
    "    metrics = {\"loss\": total / max(len(loader), 1)}\n",
    "    if TASK == \"classification\": metrics.update(cls_metrics(Y, P, S))\n",
    "    else:                        metrics.update(reg_metrics(HBT, HBP))\n",
    "    return metrics, Y, P, HBT, HBP, S\n",
    "\n",
    "print(\"run_epoch_mm ready.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9536d2b6",
   "metadata": {},
   "source": [
    "## Section 9 — K-fold runner (test mean ± std)\n",
    "\n",
    "For each fold: fit tabular stats on the fold's training rows, standardise train/val/**test**\n",
    "with them (no leakage), build a fresh model via `model_factory(tab_dim)`, train with\n",
    "early stopping, and evaluate on the **fixed** test set. Reports per-fold and mean±std —\n",
    "the numbers to put in the paper. `K=1` → a single stratified holdout."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "caabf671",
   "metadata": {},
   "outputs": [],
   "source": [
    "RESULTS = []          # main-pass results\n",
    "ABLATION_RESULTS = []  # ablation results\n",
    "\n",
    "def _fold_indices():\n",
    "    if K == 1:\n",
    "        idx = np.arange(len(POOL_DF))\n",
    "        tr, vl = train_test_split(idx, test_size=VAL_SPLIT,\n",
    "                                  random_state=SEED, stratify=POOL_LBL)\n",
    "        return [(tr, vl)]\n",
    "    skf = StratifiedKFold(n_splits=K, shuffle=True, random_state=SEED)\n",
    "    return list(skf.split(POOL_DF, POOL_LBL))\n",
    "\n",
    "def _build_loaders(tr_df, vl_df, numeric_feats, use_ses, stats):\n",
    "    T_TR, T_VA = build_transforms(True), build_transforms(False)\n",
    "    kw = dict(batch_size=BATCH_SIZE, num_workers=NUM_WORKERS,\n",
    "              pin_memory=(DEVICE == \"cuda\"), drop_last=False)\n",
    "    tr_ds = MMDataset(tr_df, T_TR, numeric_feats, use_ses, stats)\n",
    "    vl_ld = DataLoader(MMDataset(vl_df, T_VA, numeric_feats, use_ses, stats),\n",
    "                       shuffle=False, **kw)\n",
    "    ts_ld = DataLoader(MMDataset(TEST_DF, T_VA, numeric_feats, use_ses, stats),\n",
    "                       shuffle=False, **kw)\n",
    "    if USE_AUGMENTATION:\n",
    "        tr_ld = make_balanced_loader(\n",
    "            dataset=tr_ds, hb_values=tr_df[HB_COL].values, batch_size=BATCH_SIZE,\n",
    "            num_workers=NUM_WORKERS, device=DEVICE, hb_filter_min=HB_FILTER_MIN,\n",
    "            hb_filter_max=HB_FILTER_MAX, aug_bins=AUG_BINS)\n",
    "    else:\n",
    "        tr_ld = DataLoader(tr_ds, shuffle=True, **kw)\n",
    "    return tr_ld, vl_ld, ts_ld\n",
    "\n",
    "def _make_sched(opt):\n",
    "    if WARMUP_EPOCHS > 0 and EPOCHS > WARMUP_EPOCHS:\n",
    "        from torch.optim.lr_scheduler import LinearLR, CosineAnnealingLR, SequentialLR\n",
    "        w = LinearLR(opt, start_factor=0.05, end_factor=1.0, total_iters=WARMUP_EPOCHS)\n",
    "        c = CosineAnnealingLR(opt, T_max=max(EPOCHS - WARMUP_EPOCHS, 1))\n",
    "        return SequentialLR(opt, [w, c], milestones=[WARMUP_EPOCHS])\n",
    "    if SCHEDULER == \"cosine\":  return torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS)\n",
    "    if SCHEDULER == \"plateau\": return torch.optim.lr_scheduler.ReduceLROnPlateau(opt, patience=3, factor=0.5)\n",
    "    return None\n",
    "\n",
    "def run_model_kfold_mm(name, model_factory, numeric_feats, use_ses,\n",
    "                       results_list=None, tag=\"\"):\n",
    "    \"\"\"Train `name` with CV. model_factory(tab_dim)->model with forward(img,tab).\"\"\"\n",
    "    if results_list is None: results_list = RESULTS\n",
    "    tab_dim = len(numeric_feats) + (1 if use_ses else 0)\n",
    "    folds = _fold_indices()\n",
    "    sep = \"=\" * 72\n",
    "    print(f\"\\n{sep}\\n  {name}   [{('holdout' if K==1 else str(K)+'-fold')}]\"\n",
    "          f\"   feats={numeric_feats}+{'SES' if use_ses else 'noSES'}  {tag}\\n{sep}\")\n",
    "\n",
    "    accs, aucs, f1s, maes, rmses, r2s = [], [], [], [], [], []\n",
    "    ts_scores, ts_preds, ts_hbp = [], [], []\n",
    "    ts_y = ts_hbt = None\n",
    "    t0 = time.time(); params = 0\n",
    "\n",
    "    for fi, (tr_idx, vl_idx) in enumerate(folds):\n",
    "        tr_df = POOL_DF.iloc[tr_idx]; vl_df = POOL_DF.iloc[vl_idx]\n",
    "        stats = fit_tab_stats(tr_df, numeric_feats)\n",
    "        tr_ld, vl_ld, ts_ld = _build_loaders(tr_df, vl_df, numeric_feats, use_ses, stats)\n",
    "\n",
    "        cls_loss = build_cls_loss((tr_df[HB_COL] < HB_THRESH).astype(int).tolist())\n",
    "        reg_loss = build_reg_loss()\n",
    "\n",
    "        model = model_factory(tab_dim).to(DEVICE)\n",
    "        if params == 0:\n",
    "            params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "        opt = torch.optim.Adam(model.parameters(), lr=LR)\n",
    "        sch = _make_sched(opt)\n",
    "        scaler = torch.cuda.amp.GradScaler() if USE_AMP and DEVICE == \"cuda\" else None\n",
    "        stop = EarlyStopper(EARLY_STOP)\n",
    "\n",
    "        for ep in range(1, EPOCHS + 1):\n",
    "            tr, *_ = run_epoch_mm(model, tr_ld, cls_loss, reg_loss, opt, GRAD_ACCUM, scaler)\n",
    "            vl, *_ = run_epoch_mm(model, vl_ld, cls_loss, reg_loss)\n",
    "            if sch is not None:\n",
    "                sch.step(vl[\"loss\"]) if SCHEDULER == \"plateau\" else sch.step()\n",
    "            line = f\"    F{fi+1} Ep{ep:02d}/{EPOCHS} TrL {tr['loss']:.4f} VlL {vl['loss']:.4f}\"\n",
    "            if TASK == \"classification\":\n",
    "                line += f\"  Acc {vl['acc']:.3f} AUC {vl['auc']:.3f} F1 {vl['f1']:.3f}\"\n",
    "            else:\n",
    "                line += f\"  MAE {vl['mae']:.3f} RMSE {vl['rmse']:.3f}\"\n",
    "            print(line)\n",
    "            if stop.step(vl[\"loss\"]):\n",
    "                print(f\"    early stop @ ep{ep}\"); break\n",
    "\n",
    "        ts, y, p, hbt, hbp, sc = run_epoch_mm(model, ts_ld, cls_loss, reg_loss)\n",
    "        if ts_y is None: ts_y, ts_hbt = y, hbt\n",
    "        ts_scores.append(sc); ts_preds.append(p); ts_hbp.append(hbp)\n",
    "        if TASK == \"classification\":\n",
    "            accs.append(ts[\"acc\"]); aucs.append(ts[\"auc\"]); f1s.append(ts[\"f1\"])\n",
    "            print(f\"    F{fi+1} TEST  Acc {ts['acc']:.4f}  AUC {ts['auc']:.4f}  F1 {ts['f1']:.4f}\")\n",
    "        else:\n",
    "            maes.append(ts[\"mae\"]); rmses.append(ts[\"rmse\"]); r2s.append(ts[\"r2\"])\n",
    "            print(f\"    F{fi+1} TEST  MAE {ts['mae']:.4f}  RMSE {ts['rmse']:.4f}  R2 {ts['r2']:.4f}\")\n",
    "        del model\n",
    "        if DEVICE == \"cuda\": torch.cuda.empty_cache()\n",
    "        gc.collect()\n",
    "\n",
    "    elapsed = time.time() - t0\n",
    "    print(\"  \" + \"-\" * 68)\n",
    "    row = dict(name=name, tag=tag, status=\"PASS\", params=params, time_s=elapsed,\n",
    "               folds=K, numeric_feats=list(numeric_feats), use_ses=use_ses)\n",
    "    if TASK == \"classification\":\n",
    "        row.update(acc_mean=float(np.nanmean(accs)), acc_std=float(np.nanstd(accs)),\n",
    "                   auc_mean=float(np.nanmean(aucs)), auc_std=float(np.nanstd(aucs)),\n",
    "                   f1_mean=float(np.nanmean(f1s)),  f1_std=float(np.nanstd(f1s)))\n",
    "        print(f\"  {name}:  Acc {row['acc_mean']:.4f}+/-{row['acc_std']:.4f}   \"\n",
    "              f\"AUC {row['auc_mean']:.4f}+/-{row['auc_std']:.4f}   \"\n",
    "              f\"F1 {row['f1_mean']:.4f}+/-{row['f1_std']:.4f}\")\n",
    "    else:\n",
    "        row.update(mae_mean=float(np.nanmean(maes)), mae_std=float(np.nanstd(maes)),\n",
    "                   rmse_mean=float(np.nanmean(rmses)), rmse_std=float(np.nanstd(rmses)),\n",
    "                   r2_mean=float(np.nanmean(r2s)),   r2_std=float(np.nanstd(r2s)))\n",
    "        print(f\"  {name}:  MAE {row['mae_mean']:.4f}+/-{row['mae_std']:.4f}   \"\n",
    "              f\"RMSE {row['rmse_mean']:.4f}+/-{row['rmse_std']:.4f}   \"\n",
    "              f\"R2 {row['r2_mean']:.4f}+/-{row['r2_std']:.4f}\")\n",
    "    results_list.append(row)\n",
    "    print(f\"  done in {elapsed:.0f}s\")\n",
    "    return row\n",
    "\n",
    "def _fail(name, e, results_list=None):\n",
    "    if results_list is None: results_list = RESULTS\n",
    "    print(f\"  {name} FAILED: {e}\"); traceback.print_exc()\n",
    "    results_list.append(dict(name=name, status=\"FAIL\", error=str(e)))\n",
    "\n",
    "print(\"K-fold multimodal runner ready.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6602e807",
   "metadata": {},
   "source": [
    "## Section 10 — Model registry (all 17 image builders)\n",
    "\n",
    "Each entry is a **zero-arg callable** returning a fresh image model (same build calls\n",
    "as `run_ensemble.ipynb`). Modules are imported once and cached. Anything that fails to\n",
    "import (e.g. a missing CUDA kernel) is simply skipped."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "21f6df41",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _add(folder):\n",
    "    p = os.path.join(MODELS_DIR, folder)\n",
    "    if p not in sys.path: sys.path.insert(0, p)\n",
    "\n",
    "def _load(mod_name, folder, filename):\n",
    "    _add(folder)\n",
    "    spec = importlib.util.spec_from_file_location(\n",
    "        mod_name, os.path.join(MODELS_DIR, folder, filename))\n",
    "    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\n",
    "    return m\n",
    "\n",
    "def _register():\n",
    "    reg = {}\n",
    "    def safe(name, fn): reg[name] = fn\n",
    "    # ---- Mamba variants ----\n",
    "    try:\n",
    "        m = _load(\"_m1\", \"01_Mamba_Official\", \"eye_hb_model.py\")\n",
    "        safe(\"Mamba1\", lambda m=m: m.build_mamba1(IMG_SIZE, embed_dim=128, depth=4))\n",
    "        safe(\"Mamba2\", lambda m=m: m.build_mamba2(IMG_SIZE, embed_dim=128, depth=4))\n",
    "    except Exception as e: print(\"  [skip] Mamba1/2:\", e)\n",
    "    try:\n",
    "        m = _load(\"_m3\", \"06_Mamba3_Minimal\", \"eye_hb_model.py\")\n",
    "        safe(\"Mamba3\", lambda m=m: m.build_model(IMG_SIZE, embed_dim=128, depth=4))\n",
    "    except Exception as e: print(\"  [skip] Mamba3:\", e)\n",
    "    for key, folder in [(\"VMamba\", \"02_VMamba\"), (\"MambaVision\", \"03_MambaVision\"),\n",
    "                        (\"MedMamba\", \"04_MedMamba\"), (\"VSSD\", \"05_VSSD_Mamba2Vision\"),\n",
    "                        (\"DSA_Mamba\", \"07_DSA_Mamba_Custom\")]:\n",
    "        try:\n",
    "            m = _load(\"_\" + key, folder, \"eye_hb_model.py\")\n",
    "            safe(key, lambda m=m: m.build_model(IMG_SIZE))\n",
    "        except Exception as e: print(f\"  [skip] {key}:\", e)\n",
    "    try:\n",
    "        m = _load(\"_em\", \"08_EfficientMamba\", \"eye_hb_model.py\")\n",
    "        safe(\"EfficientMamba\", lambda m=m: m.build_model(\n",
    "            img_size=IMG_SIZE, embed_dim=256, depth=4, freeze_backbone=FREEZE_BACKBONE))\n",
    "    except Exception as e: print(\"  [skip] EfficientMamba:\", e)\n",
    "    try:\n",
    "        m = _load(\"_asm\", \"09_AdaptiveScanMamba\", \"adaptive_scan_mamba.py\")\n",
    "        safe(\"AdaptiveScan\", lambda m=m: m.build_adaptive_scan_mamba(\n",
    "            img_size=IMG_SIZE, embed_dim=NEW_MODEL_CFG[\"embed_dim\"],\n",
    "            depth=NEW_MODEL_CFG[\"depth\"], d_state=NEW_MODEL_CFG[\"d_state\"],\n",
    "            colour_proj=NEW_MODEL_CFG[\"colour_proj\"]))\n",
    "    except Exception as e: print(\"  [skip] AdaptiveScan:\", e)\n",
    "    try:\n",
    "        m = _load(\"_moe\", \"10_MoEMamba\", \"moe_mamba.py\")\n",
    "        safe(\"MoEMamba\", lambda m=m: m.build_moe_mamba(\n",
    "            img_size=IMG_SIZE, embed_dim=NEW_MODEL_CFG[\"embed_dim\"],\n",
    "            depth=NEW_MODEL_CFG[\"depth\"], n_experts=NEW_MODEL_CFG[\"n_experts\"],\n",
    "            d_state=NEW_MODEL_CFG[\"d_state\"]))\n",
    "    except Exception as e: print(\"  [skip] MoEMamba:\", e)\n",
    "    try:\n",
    "        m = _load(\"_cf\", \"11_CrossFusionMamba\", \"cross_fusion_mamba.py\")\n",
    "        safe(\"CrossFusion\", lambda m=m: m.build_cross_fusion_mamba(\n",
    "            img_size=IMG_SIZE, embed_dim=NEW_MODEL_CFG[\"embed_dim\"],\n",
    "            depth=NEW_MODEL_CFG[\"depth\"], d_state=NEW_MODEL_CFG[\"d_state\"]))\n",
    "    except Exception as e: print(\"  [skip] CrossFusion:\", e)\n",
    "    # ---- CNN / ViT baselines (timm) ----\n",
    "    try:\n",
    "        import timm\n",
    "        class TimmWrapper(nn.Module):\n",
    "            def __init__(self, backbone_name, pretrained=True):\n",
    "                super().__init__()\n",
    "                self.backbone = timm.create_model(backbone_name, pretrained=pretrained, num_classes=0)\n",
    "                fd = self.backbone.num_features\n",
    "                self.cls_head = nn.Sequential(nn.LayerNorm(fd), nn.Linear(fd, 2))\n",
    "                self.reg_head = nn.Sequential(nn.LayerNorm(fd), nn.Linear(fd, 1))\n",
    "            def forward(self, x):\n",
    "                f = self.backbone(x)\n",
    "                return self.cls_head(f), self.reg_head(f).squeeze(-1)\n",
    "        for key, bb in [(\"ResNet50\", \"resnet50\"), (\"EfficientNetB3\", \"efficientnet_b3\"),\n",
    "                        (\"DenseNet121\", \"densenet121\"), (\"MobileNetV3\", \"mobilenetv3_large_100\"),\n",
    "                        (\"ViT_B16\", \"vit_base_patch16_224\")]:\n",
    "            safe(key, lambda bb=bb: TimmWrapper(bb, pretrained=True))\n",
    "    except Exception as e: print(\"  [skip] timm baselines:\", e)\n",
    "    return reg\n",
    "\n",
    "IMG_BUILDERS = _register()\n",
    "print(\"Registered image builders:\", list(IMG_BUILDERS.keys()))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c2fa3cd7",
   "metadata": {},
   "source": [
    "## Section 11 — MAIN PASS: all models with the default fusion\n",
    "\n",
    "Runs every enabled model. If `USE_TABULAR=True`, each backbone is wrapped in\n",
    "`MultiModalWrapper(..., fusion=FUSION)` with the configured tabular features; otherwise\n",
    "`ImageOnlyWrapper` (pure image baseline). Same K-fold protocol for all."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3f42a013",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_factory(img_build_fn, use_tabular, fusion):\n",
    "    if use_tabular:\n",
    "        return lambda tab_dim: MultiModalWrapper(img_build_fn(), tab_dim, fusion=fusion)\n",
    "    return lambda tab_dim: ImageOnlyWrapper(img_build_fn())\n",
    "\n",
    "_active_numeric = NUMERIC_FEATURES if USE_TABULAR else []\n",
    "_active_ses     = USE_SES if USE_TABULAR else False\n",
    "\n",
    "for name, on in RUN.items():\n",
    "    if not on:\n",
    "        print(f\"{name} skipped.\"); continue\n",
    "    if name not in IMG_BUILDERS:\n",
    "        print(f\"{name}: no builder available, skipped.\"); continue\n",
    "    try:\n",
    "        factory = make_factory(IMG_BUILDERS[name], USE_TABULAR, FUSION)\n",
    "        run_model_kfold_mm(name, factory, _active_numeric, _active_ses,\n",
    "                           tag=(f\"fusion={FUSION}\" if USE_TABULAR else \"image-only\"))\n",
    "    except Exception as e:\n",
    "        _fail(name, e)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c94868ea",
   "metadata": {},
   "source": [
    "## Section 12 — Main results table & chart"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "096d356b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def results_frame(rows):\n",
    "    ok = [r for r in rows if r.get(\"status\") == \"PASS\"]\n",
    "    if not ok:\n",
    "        print(\"No successful runs.\"); return None\n",
    "    df = pd.DataFrame(ok)\n",
    "    if TASK == \"classification\":\n",
    "        df = df.sort_values(\"auc_mean\", ascending=False)\n",
    "        cols = [\"name\", \"tag\", \"params\", \"acc_mean\", \"acc_std\",\n",
    "                \"auc_mean\", \"auc_std\", \"f1_mean\", \"f1_std\", \"time_s\"]\n",
    "    else:\n",
    "        df = df.sort_values(\"mae_mean\", ascending=True)\n",
    "        cols = [\"name\", \"tag\", \"params\", \"mae_mean\", \"mae_std\",\n",
    "                \"rmse_mean\", \"rmse_std\", \"r2_mean\", \"r2_std\", \"time_s\"]\n",
    "    return df[[c for c in cols if c in df.columns]].reset_index(drop=True)\n",
    "\n",
    "MAIN_DF = results_frame(RESULTS)\n",
    "if MAIN_DF is not None:\n",
    "    print(MAIN_DF.to_string(index=False))\n",
    "    MAIN_DF.to_csv(\"multimamba_main_results.csv\", index=False)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(11, max(3, 0.45 * len(MAIN_DF))))\n",
    "    if TASK == \"classification\":\n",
    "        ax.barh(MAIN_DF[\"name\"], MAIN_DF[\"auc_mean\"],\n",
    "                xerr=MAIN_DF[\"auc_std\"], color=\"steelblue\")\n",
    "        ax.set_xlabel(\"Test AUC (mean +/- std)\")\n",
    "    else:\n",
    "        ax.barh(MAIN_DF[\"name\"], MAIN_DF[\"mae_mean\"],\n",
    "                xerr=MAIN_DF[\"mae_std\"], color=\"indianred\")\n",
    "        ax.set_xlabel(\"Test MAE g/dL (lower is better)\")\n",
    "    ax.invert_yaxis(); ax.set_title(f\"MULTIMAMBA — main pass ({CV_DESC}, fusion={FUSION})\")\n",
    "    plt.tight_layout(); plt.savefig(\"multimamba_main_results.png\", dpi=110,\n",
    "                                    bbox_inches=\"tight\"); plt.show()\n"
   ]
  },
